# ======================================================================
# Xboard + OlcRTC — .env.example
# Скопируйте в .env: cp .env.example .env
# Затем запустите: docker compose run -it --rm web php artisan xboard:install
# ======================================================================

# ====== Базовые настройки Xboard ======
APP_NAME=OlcRTC-VPN
APP_ENV=production
APP_KEY=base64:PZXk5vTuTinfeEVG5FpYv2l6WEhLsyvGpiWK7IgJJ60=
APP_DEBUG=false
APP_URL=http://your-domain.com

LOG_CHANNEL=stack

# ====== База данных (SQLite — zero-config, работает «из коробки») ======
# Если хотите MySQL — раскомментируйте и поднимите отдельный контейнер
DB_CONNECTION=sqlite
DB_DATABASE=/www/.docker/.data/xboard.sqlite

# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=xboard
# DB_USERNAME=xboard
# DB_PASSWORD=strong-mysql-pass

# ====== Redis (встроенный в контейнер Xboard) ======
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# ====== Почта (для регистрации, восстановления пароля, чеков 54-ФЗ) ======
MAIL_DRIVER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=vpn@your-domain.com
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=vpn@your-domain.com
MAIL_FROM_NAME=OlcRTC-VPN

# ====== Резервные копии и автообновления ======
ENABLE_AUTO_BACKUP_AND_UPDATE=false
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# ====== Порт Xboard на хосте ======
XBOARD_PORT=7001

# ======================================================================
# OlcRTC — интеграция (обязательно поменяйте OLCRMGR_API_KEY!)
# ======================================================================

# Секретный Bearer-токен между Xboard и olcrtc-manager.
# Сгенерируйте крепкий: openssl rand -hex 32
OLCRMGR_API_KEY=please-change-me-run-openssl-rand-hex-32

# Провайдер и транспорт по умолчанию
# Provider: jitsi | wbstream | telemost
OLCRMGR_DEFAULT_PROVIDER=jitsi
# Transport: datachannel | vp8channel | seichannel | videochannel
OLCRMGR_DEFAULT_TRANSPORT=datachannel
# DNS для клиентов
OLCRMGR_DEFAULT_DNS=8.8.8.8:53
# Токен модератора (только для wbstream/telemost datachannel)
OLCRMGR_DEFAULT_TOKEN=

# Релиз olcrtc, который скачать при сборке образа manager (latest или тег vX.Y.Z)
OLCRTC_RELEASE=latest

# Prevent reinstallation flag (xboard:install поставит true)
INSTALLED=false
