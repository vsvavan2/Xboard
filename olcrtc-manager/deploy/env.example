# ================================
# olcrtc-manager environment file
# Copy to /etc/default/olcrtc-manager
# ================================

# Адрес и порт, на которых слушать API (не выставляйте наружу без HTTPS/файрвола!)
OLCRMGR_LISTEN=127.0.0.1:8080

# Секретный Bearer-токен для Xboard.
# Сгенерируйте: openssl rand -hex 32
OLCRMGR_API_KEY=change-me-please-run-openssl-rand-hex-32

# Путь к SQLite БД
OLCRMGR_DB=/var/lib/olcrtc-manager/instances.db

# Путь к бинарнику olcrtc (собранный с вашего репозитория)
OLCRMGR_BIN=/usr/local/bin/olcrtc

# Каталог, где будут хранить YAML-конфиги и логи инстансов
OLCRMGR_INSTANCES_DIR=/var/lib/olcrtc-manager/instances

# ===== Параметры по умолчанию (можно переопределить на каждого пользователя при создании инстанса
OLCRMGR_DEFAULT_DNS=8.8.8.8:53
# jitsi / wbstream / telemost
OLCRMGR_DEFAULT_PROVIDER=jitsi
# datachannel / vp8channel / seichannel / videochannel
OLCRMGR_DEFAULT_TRANSPORT=datachannel
# Токен модератора (опционально — только для wbstream datachannel
OLCRMGR_DEFAULT_TOKEN=
