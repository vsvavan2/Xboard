# TLS-terminating front for the panel (опциональный контейнер caddy-tls).
#
# Зачем: часть платёжных шлюзов (ЮKassa) принимает вебхуки ТОЛЬКО по HTTPS на
# порт 443. Панель по умолчанию слушает :80 (внутренний Caddy на :7001) и
# рассчитана на внешний reverse-proxy. Если своего прокси с TLS нет, этот
# контейнер сам выпускает сертификат Let's Encrypt и терминирует HTTPS.
#
# Включается профилем compose "tls" (COMPOSE_PROFILES=tls в .env) — по
# умолчанию выключен, чтобы не мешать установкам за внешним прокси.
#
# Особенности:
#   * слушает только :443; сертификат берётся по TLS-ALPN-01 (порт :80 занят
#     основным контейнером xboard), поэтому HTTP-01 отключён;
#   * весь трафик (включая /ws) проксируется на встроенный Caddy панели
#     xboard:7001, который уже разводит HTTP и WebSocket;
#   * сохраняем Referrer-Policy: no-referrer (иначе ЮMoney Quickpay
#     отклоняет переходы с ошибкой reason=referer).
#
# ────────────────────────────────────────────────────────────────────────────
# ДОМЕНЫ ЭТОГО ДЕПЛОЯ
# ────────────────────────────────────────────────────────────────────────────
#   основной:              netwifi.ru      (панель)
#   редирект на основной:  x-vpn.ru        (прежний основной; блокируется РКН)
#                          vpnfy.ru        (доп. домен)
#                          vless.24x7.hk   (прежний домен)
#                          а также www-варианты всех перечисленных доменов
#
# Переадресация мгновенная (HTTP 301), без промежуточной страницы.
# ИСКЛЮЧЕНИЕ: пути вебхуков платёжных систем (/api/v1/guest/payment/notify/*,
# /yoomoney-webhook, /yoomoney/callback) НЕ редиректятся — они всегда
# проксируются в панель. Иначе POST-уведомления об оплате с прежних доменов
# уходили бы по редиректу и платежи перестали бы зачисляться.
#
# Чтобы сменить основной домен — поменяйте адрес ниже (и в блоке redir).
# ────────────────────────────────────────────────────────────────────────────

{
	# Admin API только на loopback контейнера: нужен для плавного применения
	# изменений Caddyfile (caddy reload) при обновлении, наружу не публикуется.
	admin 127.0.0.1:2019
	persist_config off
	# Контактный e-mail для Let's Encrypt (необязательно). По умолчанию НЕ
	# указываем: Let's Encrypt выпускает сертификат и без контакта, а адрес
	# вида *@example.com он отклоняет (invalidContact). Если хотите получать
	# письма об истечении — раскомментируйте строку ниже и укажите РЕАЛЬНЫЙ
	# адрес на вашем домене (например: email admin@x-vpn.ru).
	# email admin@your-domain.example
	log {
		output stdout
		format console
	}
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

# ── Фрагмент: проксирование в панель ───────────────────────────────────────
(panel_proxy) {
	tls {
		issuer acme {
			# :80 занят основным контейнером → валидируем через :443.
			disable_http_challenge
		}
	}
	header Referrer-Policy "no-referrer"
	reverse_proxy xboard:7001 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# ── Фрагмент: редирект на основной домен (кроме путей вебхуков) ────────────
(redirect_to_primary) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	header Referrer-Policy "no-referrer"

	# Вебхуки платёжек должны работать на любом из доменов — проксируем как есть.
	@payment_hooks path /api/v1/guest/payment/notify/* /yoomoney-webhook /yoomoney/callback
	handle @payment_hooks {
		reverse_proxy xboard:7001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Всё остальное — мгновенный постоянный редирект на основной домен.
	handle {
		redir https://netwifi.ru{uri} permanent
	}
}

# ── Основной домен ────────────────────────────────────────────────────────
netwifi.ru {
	import panel_proxy
}

# ── www основного домена → на основной ────────────────────────────────────
www.netwifi.ru {
	import redirect_to_primary
}

# ── Прежний основной домен: редирект на новый основной (блокируется РКН) ──
x-vpn.ru {
	import redirect_to_primary
}

www.x-vpn.ru {
	import redirect_to_primary
}

# ── Дополнительный домен: редирект на основной ────────────────────────────
vpnfy.ru {
	import redirect_to_primary
}

www.vpnfy.ru {
	import redirect_to_primary
}

# ── Прежний домен: редирект на основной ───────────────────────────────────
vless.24x7.hk {
	import redirect_to_primary
}
