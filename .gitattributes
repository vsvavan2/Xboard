# ======================================================================
#  Normalize line endings — CRITICAL for Dockerfiles, shell scripts, YAML
#  Linux containers will FAIL to execute /entrypoint.sh if it has CRLF!
# ======================================================================

# Text files that MUST be LF (UNIX line endings)
*.sh                 text eol=lf
*.bash               text eol=lf
Dockerfile           text eol=lf
Dockerfile.*         text eol=lf
*.service            text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
*.go                 text eol=lf
*.mod                text eol=lf
*.sum                text eol=lf
Makefile             text eol=lf
*.php                text eol=lf
*.json               text eol=lf
*.ini                text eol=lf
*.conf               text eol=lf
Caddyfile*           text eol=lf
.env*                text eol=lf
README*              text eol=lf
*.md                 text eol=lf
*.vue                text eol=lf
*.js                 text eol=lf
*.ts                 text eol=lf

# Binary files — do not touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.db   binary
*.sqlite binary
