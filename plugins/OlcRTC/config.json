{
    "name": "OlcRTC Integration",
    "code": "olc_rtc",
    "version": "1.0.0",
    "description": "Интеграция Xboard с olcrtc-manager. Регистрация + тестовый период 6ч, оплата ЮKassa, автоматическая выдача olcrtc:// ссылок, YAML и подписок в личном кабинете.",
    "author": "OlcRTC Team",
    "require": {
        "xboard": ">=1.0.0"
    },
    "config": {
        "manager_url": {
            "type": "string",
            "default": "http://127.0.0.1:8080",
            "label": "URL olcrtc-manager",
            "description": "Адрес olcrtc-manager (http://host:port)"
        },
        "manager_api_key": {
            "type": "string",
            "default": "change-me",
            "label": "API-ключ olcrtc-manager",
            "description": "Bearer-токен для доступа к olcrtc-manager (OLCRMGR_API_KEY)"
        },
        "default_provider": {
            "type": "string",
            "default": "jitsi",
            "label": "Провайдер по умолчанию",
            "description": "jitsi, wbstream, telemost"
        },
        "default_transport": {
            "type": "string",
            "default": "datachannel",
            "label": "Транспорт по умолчанию",
            "description": "datachannel, vp8channel, seichannel, videochannel"
        },
        "default_dns": {
            "type": "string",
            "default": "8.8.8.8:53",
            "label": "DNS по умолчанию",
            "description": "DNS-сервер для клиентов olcrtc"
        },
        "auth_token": {
            "type": "string",
            "default": "",
            "label": "Токен авторизации WBStream/Telemost",
            "description": "Модераторский токен (опционально, для datachannel на wbstream)"
        },
        "trial_hours": {
            "type": "number",
            "default": 6,
            "label": "Длительность тестового периода (часов)",
            "description": "Сколько часов даётся новому пользователю бесплатно после регистрации"
        },
        "trial_enabled": {
            "type": "boolean",
            "default": true,
            "label": "Включить тестовый период",
            "description": "Отключить, если триал не нужен"
        },
        "default_comment": {
            "type": "string",
            "default": "olcrtc subscription",
            "label": "Комментарий по умолчанию (MIMO)",
            "description": "Отображается в URI и подписке клиента"
        }
    }
}
